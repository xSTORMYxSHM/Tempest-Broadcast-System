IDI_ICON1 ICON DISCARDABLE "cmake/windows/tempest-broadcast-system.ico"

1 VERSIONINFO
FILEVERSION ${OBS_VERSION_MAJOR},${OBS_VERSION_MINOR},${OBS_VERSION_PATCH},0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Tempest Mainframe"
      VALUE "FileDescription", "Tempest Broadcast System"
      VALUE "FileVersion", "${OBS_VERSION_CANONICAL}"
      VALUE "InternalName", "tempest-broadcast-system"
      VALUE "OriginalFilename", "tempest-broadcast-system.exe"
      VALUE "ProductName", "Tempest Broadcast System"
      VALUE "ProductVersion", "${OBS_VERSION_CANONICAL}"
      VALUE "Comments", "Private Tempest Mainframe broadcast workstation, built on OBS Studio"
      VALUE "LegalCopyright", "${OBS_LEGAL_COPYRIGHT}"
    END
  END

  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
